# Leave VITE_API_BASE_URL empty to run fully in-browser with the mock API (localStorage).
# Set it to your API Gateway URL (fronting the Lambda) for real persistence, e.g.
# VITE_API_BASE_URL=https://abc123.execute-api.us-east-1.amazonaws.com
VITE_API_BASE_URL=

# Sign-in mode when VITE_API_BASE_URL is set: "cognito" (default) or "local".
# "local" = password-less sign-in for the backend's local dev server (cd backend && npm run dev).
# It only works under `npm run dev`; production builds always use Cognito.
# Local setup — put these two lines in web/.env.local:
#   VITE_API_BASE_URL=http://127.0.0.1:8787
#   VITE_AUTH_MODE=local
VITE_AUTH_MODE=

# AWS Cognito user pool app client (no client secret). Required when VITE_API_BASE_URL is set.
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_CLIENT_ID=

# Public contact info shown on the site
VITE_PUBLIC_PHONE=(214) 555-0142
VITE_PUBLIC_EMAIL=hello@dfwlawnpros.com
