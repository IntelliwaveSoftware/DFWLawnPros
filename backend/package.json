{
  "name": "dfw-lawn-pros-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env scripts/dev-server.ts",
    "build": "prisma generate && tsc --noEmit && node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "deploy": "npm run build && sam deploy --guided"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@aws-sdk/client-lambda": "^3.1141.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true
  }
}
